PROJECT_NAME="CampusLoop Backend"
API_V1_STR="/api/v1"
SECRET_KEY="campusloop_super_secret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (SQLite by default for zero-config dev, PostgreSQL for production)
DATABASE_URL="sqlite:///./campusloop.db"
# PostgreSQL Production Example:
# DATABASE_URL="postgresql://campus_user:campus_password@localhost:5432/campusloop_db"

QR_SECRET_SALT="campusloop_qr_hmac_secret_salt"
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173"]
